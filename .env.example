# Safe development placeholders only. Copy to .env and replace locally.
DOCUMI_ENV=development
DOCUMI_HTTP_ADDRESS=:8080
DOCUMI_LOG_LEVEL=info
DOCUMI_DATABASE_URL=postgres://documi:documi_dev_only@localhost:5432/documi?sslmode=disable
DOCUMI_STORAGE_ROOT=./.data/storage
DOCUMI_TEMPORAL_ADDRESS=localhost:7233
DOCUMI_TEMPORAL_NAMESPACE=default
DOCUMI_OIDC_ISSUER=http://localhost:8081/realms/documi
DOCUMI_OIDC_CLIENT_ID=documi-web
DOCUMI_AI_PROVIDER=disabled
DOCUMI_AI_BASE_URL=
AIR_GAPPED=false

# Compose-only development values. Never use these defaults in production.
POSTGRES_USER=documi
POSTGRES_PASSWORD=documi_dev_only
POSTGRES_DB=documi
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_only
