# Safe development placeholders only. Copy to .env and replace locally.
DOCUMI_ENV=development
DOCUMI_HTTP_ADDRESS=:8080
DOCUMI_LOG_LEVEL=info
DOCUMI_DATABASE_URL=postgres://documi:documi_dev_only@localhost:5432/documi?sslmode=disable
DOCUMI_STORAGE_ROOT=./.data/storage
DOCUMI_TEMPORAL_ADDRESS=localhost:7233
DOCUMI_TEMPORAL_NAMESPACE=default
DOCUMI_OIDC_ISSUER=http://localhost:8081/realms/documi
DOCUMI_OIDC_CLIENT_ID=documi-web
DOCUMI_AI_PROVIDER=disabled
DOCUMI_AI_BASE_URL=
AIR_GAPPED=false
DOCUMI_PUBLIC_URL=http://localhost:8080
DOCUMI_AUTH_MODE=development
DOCUMI_OIDC_AUDIENCE=documi-api
DOCUMI_DEV_SUBJECT=local-admin
DOCUMI_DEV_EMAIL=admin@documi.local
DOCUMI_DEV_NAME=Local administrator

# Optional document editors. Keep disabled unless the corresponding deployment
# and document-version service are configured. Secrets below are placeholders.
DOCUMI_EDITOR_TOKEN_SECRET=replace-with-at-least-32-random-characters
COLLABORA_ENABLED=false
COLLABORA_URL=http://localhost:9980
COLLABORA_PUBLIC_URL=http://localhost:9980
ONLYOFFICE_ENABLED=false
ONLYOFFICE_URL=http://localhost:8083
ONLYOFFICE_JWT_SECRET=replace-with-at-least-32-random-characters

# Host port used by the Compose PostgreSQL service. If another local PostgreSQL
# owns 5432, change this and the port in DOCUMI_DATABASE_URL together.
DOCUMI_POSTGRES_PORT=5432

# Compose-only development values. Never use these defaults in production.
POSTGRES_USER=documi
POSTGRES_PASSWORD=documi_dev_only
POSTGRES_DB=documi
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_only
