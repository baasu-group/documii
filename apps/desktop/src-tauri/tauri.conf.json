{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Documi",
  "version": "0.1.0",
  "identifier": "org.documi.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Documi", "width": 1280, "height": 820, "minWidth": 960, "minHeight": 640 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "resources": { "resources/libreoffice/documi-libreoffice.oxt": "libreoffice/documi-libreoffice.oxt" }
  }
}
