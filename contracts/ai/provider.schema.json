{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documi.org/contracts/ai/provider.schema.json",
  "title": "Documi AI provider configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "enabled"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["disabled", "ollama", "llama_cpp", "vllm", "openai_compatible", "custom_http"] },
    "enabled": { "type": "boolean" },
    "base_url": { "type": ["string", "null"], "format": "uri" },
    "secret_reference": { "type": ["string", "null"] }
  }
}
